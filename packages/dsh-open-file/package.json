{
  "name": "dsh-open-file",
  "version": "0.1.0",
  "description": "Web 插件：对话中产物路径一键处理 —— 单击=话内预览（文本/markdown/图片/xlsx 表格），Ctrl+点击=系统默认应用打开，📂=在文件管理器中定位所在文件夹",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "markdown-it": "^13.0.2",
    "xlsx": "^0.18.5"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
