{
  "name": "dsh-virtual-desktop",
  "version": "0.1.0",
  "description": "DSH 虚拟桌面 MVP（本机版）：网页内看本机屏幕、远程点击/输入/按键，复刻豆包虚拟桌面的本机闭环；隔离不抢屏为下一阶段",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
