{
  "name": "dsh-opencode-go-pricing",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) plugin: keeps OpenCode GO model display names in sync with the official 2x-usage markers published by models.dev, so the model selector always shows the current pricing label.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "pricing",
    "2x",
    "usage",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
